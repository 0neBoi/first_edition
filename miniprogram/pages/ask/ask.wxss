.container { padding: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.input { width: 100%; min-height: 160rpx; padding: 16rpx; border: 1rpx solid #eee; border-radius: 8rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.answer { margin-top: 32rpx; padding: 24rpx; background: #f5f5f5; border-radius: 8rpx; }
.answer-title { font-weight: 600; margin-bottom: 12rpx; }
.answer-text { font-size: 28rpx; white-space: pre-wrap; }

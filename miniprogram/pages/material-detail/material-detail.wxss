.container { padding: 24rpx; }
.header { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }
.section { margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.gen-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.knowledge-item, .q-item { padding: 20rpx; background: #f5f5f5; border-radius: 8rpx; margin-bottom: 16rpx; }
.kp-title, .q-title { display: block; font-weight: 500; margin-bottom: 8rpx; }
.kp-content, .q-answer, .q-analysis { font-size: 26rpx; color: #333; }
.empty-tip { color: #999; font-size: 26rpx; }
